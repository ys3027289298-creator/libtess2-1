build --cxxopt=-std=c++20
test --test_output=errors
common --enable_bzlmod

# Sanitizer build: AddressSanitizer + UndefinedBehaviorSanitizer.
# Opt-in only; the default build is completely unaffected.
# Usage: bazel test --config=asan //...
build:asan --copt=-fsanitize=address,undefined
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-fno-sanitize-recover=all
build:asan --copt=-g
build:asan --copt=-O1
build:asan --cxxopt=-fsanitize=address,undefined
build:asan --cxxopt=-fno-omit-frame-pointer
build:asan --cxxopt=-fno-sanitize-recover=all
build:asan --linkopt=-fsanitize=address,undefined
build:asan --test_env=ASAN_OPTIONS=detect_leaks=1:abort_on_error=1
build:asan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
