[2.003, "o", "# 从 git HEAD（未修复）取出源码构建 repro\r\n"]
[0.022, "o", "$ gcc -fsanitize=address,undefined repro.c Source/*.c -o repro_dbg\r\n"]
[4.917, "o", "$ ./repro_dbg < case1_mesh_corruption.txt   # CDT 翻转破坏网格（断言）\r\n"]
[0.006, "o", "repro_dbg: Source/mesh.c:801: tessMeshFlipEdge: Assertion `a0->Onext->Sym->Lnext == a0' failed.\r\n"]
