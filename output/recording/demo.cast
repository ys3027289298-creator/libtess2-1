[1.002, "o", "$ ./repro_rel < case2_null_vertex.txt        # release 下空顶点访问（UB）\r\n"]
[0.005, "o", "Source/tess.c:738:6: runtime error: member access within misaligned address 0xbebebebebebebebe for type 'struct TESShalfEdge', which requires 8 byte alignment\r\n0xbebebebebebebebe: note: pointer points here\r\n"]
[1.003, "o", "$ ./repro_rel < case3_signed_overflow.txt    # maxIter 有符号溢出（UB）\r\n"]
[0.146, "o", "Source/tess.c:487:10: runtime error: signed integer overflow: 50970 * 50970 cannot be represented in type 'int'\r\n"]
[2.006, "o", "\r\n================================================================\r\n  [4/6] 修复内容：Source/tess.c（CDT 翻转守卫 + 溢出钳制）\r\n================================================================\r\n"]
[2.003, "o", "$ git diff Source/tess.c\r\n"]
[0.007, "o", "\u001b[1mdiff --git a/Source/tess.c b/Source/tess.c\u001b[m\r\n\u001b[1mindex 0b47921..e369ea0 100755\u001b[m\r\n\u001b[1m--- a/Source/tess.c\u001b[m\r\n\u001b[1m+++ b/Source/tess.c\u001b[m\r\n\u001b[36m@@ -41,6 +41,7 @@\u001b[m\r\n #include <math.h>\u001b[m\r\n #include <stdio.h>\u001b[m\r\n #include <stdlib.h>\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m#include <limits.h>\u001b[m\r\n \u001b[m\r\n #define TRUE 1\u001b[m\r\n #define FALSE 0\u001b[m\r\n\u001b[36m@@ -454,6 +455,38 @@\u001b[m \u001b[mTESShalfEdge *stackPop( EdgeStack *stack )\u001b[m\r\n \u001b[m\r\n //\tStarting with a valid triangulation, uses the Edge Flip algorithm to\u001b[m\r\n //\trefine the triangulation into a Constrained Delaunay Triangulation.\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// tessMeshFlipEdge() requires that both faces adjacent to the edge are\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// triangles, that the two faces share no other edge, and that the flip\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// does not collapse the edge onto itself. Degenerate input can produce\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// meshes where these conditions do not hold; flipping such an edge would\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// corrupt the mesh topology (and lead to out-of-bounds accesses later).\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mstatic int EdgeIsFlippable( TESShalfEdge *e )\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m{\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mTESShalfEdge *a1 = e->Lnext;\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mTESShalfEdge *a2 = a1->Lnext;\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mTESShalfEdge *b0 = e->Sym;\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mTESShalfEdge *b1 = b0->Lnext;\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mTESShalfEdge *b2 = b1->Lnext;\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m// Both adjacent faces must be triangles.\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif (a2->Lnext != e || b2->Lnext != b0)\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mreturn FALSE;\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m// The two faces must not share another edge.\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif (a1 == b2->Sym || a2 == b1->Sym)\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mreturn FALSE;\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m// The vertices of each triangle must be distinct, and the flipped\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m// edge (which connects the two opposite vertices) must not become\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m// a zero-length edge.\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif (a2->Org == e->Org || a2->Org == b0->Org)\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mreturn FALSE;\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif (b2->Org == e->Org || b2->Org == b0->Org)\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mreturn FALSE;\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif (a2->Org == b2->Org)\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mreturn FALSE;\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mreturn TRUE;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n"]
[0.000, "o", "\u001b[32m+\u001b[m\r\n void tessMeshRefineDelaunay( TESSmesh *mesh, TESSalloc *alloc )\u001b[m\r\n {\u001b[m\r\n \t// At this point, we have a valid, but not optimal, triangulation.\u001b[m\r\n\u001b[36m@@ -484,7 +517,8 @@\u001b[m \u001b[mvoid tessMeshRefineDelaunay( TESSmesh *mesh, TESSalloc *alloc )\u001b[m\r\n \u001b[m\r\n \t// The algorithm should converge on O(n^2), since the predicate is not robust,\u001b[m\r\n \t// we'll save guard against infinite loop.\u001b[m\r\n"]
[0.000, "o", "\u001b[31m-\tmaxIter = maxFaces * maxFaces;\u001b[m\r\n"]
[0.000, "o", "\u001b[32m+\u001b[m"]
[0.000, "o", "\t\u001b[32m// Guard against signed integer overflow on very large inputs.\u001b[m\r\n"]
[0.000, "o", "\u001b[32m+\u001b[m\t\u001b[32mmaxIter = (maxFaces > 46340) ? INT_MAX : maxFaces * maxFaces;\u001b[m\r\n \u001b[m\r\n \t// Pop stack until we find a reversed edge\u001b[m\r\n \t// Flip the reversed edge, and insert any of the four opposite edges\u001b[m\r\n"]
[0.000, "o", "\u001b[36m@@ -492,7 +526,7 @@\u001b[m \u001b[mvoid tessMeshRefineDelaunay( TESSmesh *mesh, TESSalloc *alloc )\u001b[m\r\n"]
[0.000, "o", " \twhile (!stackEmpty(&stack) && iter < maxIter) {\u001b[m\r\n \t\te = stackPop(&stack);\u001b[m\r\n \t\te->mark = e->Sym->mark = 0;\u001b[m\r\n"]
[0.000, "o", "\u001b[31m-\t\tif (!tesedgeIsLocallyDelaunay(e)) {\u001b[m\r\n"]
[0.000, "o", "\u001b[32m+\u001b[m\t\t\u001b[32mif (EdgeIsFlippable(e) && !tesedgeIsLocallyDelaunay(e)) {\u001b[m\r\n \t\t\tTESShalfEdge *edges[4];\u001b[m\r\n \t\t\tint i;\u001b[m\r\n \t\t\ttessMeshFlipEdge(mesh, e);\u001b[m\r\n\u001b[36m@@ -1130,4 +1164,3 @@\u001b[m \u001b[mTESSstatus tessGetStatus( TESStesselator *tess )\u001b[m\r\n {\u001b[m\r\n \treturn tess->status;\u001b[m\r\n }\u001b[m\r\n\u001b[31m-\u001b[m\r\n"]
